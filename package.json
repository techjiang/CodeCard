{
  "name": "codecard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:standalone": "vue-tsc -b && vite build --config vite.standalone.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "description": "输入代码或笔记，一键生成可分享的技术卡片。纯本地、离线、12 套模板。",
  "homepage": "https://github.com/techjiang/CodeCard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techjiang/CodeCard.git"
  },
  "keywords": [
    "vue3",
    "vite",
    "typescript",
    "code-card",
    "markdown",
    "canvas",
    "export",
    "offline"
  ],
  "license": "MIT"
}
